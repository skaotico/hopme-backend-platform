{
  "openapi": "3.0.3",
  "info": {
    "title": "Homelab Collector Platform - Auth API",
    "description": "API de Autenticación, Registro y Autorización (IAM) del Homelab Collector Platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor Dinámico (Auto-detectar)"
    },
    {
      "url": "http://192.168.1.20:9090",
      "description": "Servidor Homelab (IP)"
    },
    {
      "url": "http://localhost:9090",
      "description": "Desarrollo Local (localhost)"
    }
  ],
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Registrar un nuevo usuario",
        "description": "Crea una nueva cuenta de usuario asignándole el rol estándar USER.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "email", "password"],
                "properties": {
                  "username": { "type": "string", "example": "skaotico" },
                  "email": { "type": "string", "example": "skaotico@homelab.local" },
                  "password": { "type": "string", "example": "secret123" }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "format": "uuid" },
                    "username": { "type": "string" },
                    "email": { "type": "string" },
                    "display_name": { "type": "string" },
                    "is_active": { "type": "boolean" },
                    "is_verified": { "type": "boolean" },
                    "created_at": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": { "description": "Datos de entrada inválidos" },
          "409": { "description": "El nombre de usuario o correo electrónico ya existe" }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Iniciar sesión de usuario",
        "description": "Verifica credenciales del usuario y emite un token JWT con roles y permisos.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email", "password"],
                "properties": {
                  "email": { "type": "string", "example": "skaotico@homelab.local" },
                  "password": { "type": "string", "example": "secret123" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Autenticación exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "token": { "type": "string", "description": "Token JWT firmado" }
                  }
                }
              }
            }
          },
          "401": { "description": "Credenciales inválidas" }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Obtener perfil del usuario logueado",
        "description": "Retorna la información básica del usuario, roles y permisos extraídos del token JWT.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Información de sesión recuperada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "user_id": { "type": "string", "format": "uuid" },
                    "username": { "type": "string" },
                    "email": { "type": "string" },
                    "roles": { "type": "array", "items": { "type": "string" } },
                    "permissions": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "401": { "description": "No autorizado o token ausente/inválido" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
