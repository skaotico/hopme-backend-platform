{
    "schemes": [
        "http"
    ],
    "swagger": "2.0",
    "info": {
        "description": "Microservicio de gestión de zonas dentro de ecoparques. Parte de la Homelab Collector Platform.",
        "title": "Homelab Platform - API Zona",
        "contact": {
            "name": "Skaotico"
        },
        "version": "1.0"
    },
    "host": "localhost:9092",
    "basePath": "/api/v1",
    "paths": {
        "/health": {
            "get": {
                "description": "Verifica que el servicio Zona está operativo",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "health"
                ],
                "summary": "Health check del servicio",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "/zonas": {
            "get": {
                "description": "Retorna la lista completa de zonas registradas",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "zonas"
                ],
                "summary": "Listar zonas",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/model.Zona"
                            }
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Crea una nueva zona asociada a un ecoparque",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "zonas"
                ],
                "summary": "Crear una zona",
                "parameters": [
                    {
                        "description": "Datos de la zona a crear",
                        "name": "zona",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.CreateZonaRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/model.Zona"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        },
        "/zonas/{id}": {
            "get": {
                "description": "Retorna los datos de una zona específica",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "zonas"
                ],
                "summary": "Obtener una zona por ID",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID de la zona",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Zona"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            },
            "put": {
                "description": "Actualiza los campos de una zona existente",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "zonas"
                ],
                "summary": "Actualizar una zona",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID de la zona",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Campos a actualizar",
                        "name": "zona",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/model.UpdateZonaRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/model.Zona"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            },
            "delete": {
                "description": "Elimina una zona por su ID",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "zonas"
                ],
                "summary": "Eliminar una zona",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID de la zona",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": true
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.APIResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "model.CreateZonaRequest": {
            "type": "object",
            "properties": {
                "area_m2": {
                    "type": "number"
                },
                "descripcion": {
                    "type": "string"
                },
                "ecoparque_id": {
                    "type": "string"
                },
                "nombre": {
                    "type": "string"
                }
            }
        },
        "model.UpdateZonaRequest": {
            "type": "object",
            "properties": {
                "area_m2": {
                    "type": "number"
                },
                "descripcion": {
                    "type": "string"
                },
                "ecoparque_id": {
                    "type": "string"
                },
                "nombre": {
                    "type": "string"
                }
            }
        },
        "model.Zona": {
            "type": "object",
            "properties": {
                "area_m2": {
                    "type": "number"
                },
                "descripcion": {
                    "type": "string"
                },
                "ecoparque_id": {
                    "type": "string"
                },
                "fecha_actualizacion": {
                    "type": "string"
                },
                "fecha_creacion": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "nombre": {
                    "type": "string"
                }
            }
        },
        "response.APIError": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "string"
                },
                "details": {
                    "type": "string"
                },
                "message": {
                    "type": "string"
                }
            }
        },
        "response.APIResponse": {
            "type": "object",
            "properties": {
                "data": {},
                "error": {
                    "$ref": "#/definitions/response.APIError"
                },
                "success": {
                    "type": "boolean"
                }
            }
        }
    }
}