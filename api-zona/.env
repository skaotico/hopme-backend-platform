# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR HTTP
# ==============================================================================
# Puerto local donde escuchará la API de Autenticación
PORT=9090

# Tiempos de espera por servicio/ruta (expresado en segundos)
TIMEOUT_LOGIN=15
TIMEOUT_REGISTER=30
TIMEOUT_ME=101

# ==============================================================================
# CONFIGURACIÓN DE SEGURIDAD (JWT)
# ==============================================================================
# Firma secreta para la emisión y verificación de tokens
JWT_SECRET=1Dos3M0M13$

# Tiempo de vida del Access Token expresado en horas (ej: 24h = 1 día)
JWT_EXPIRATION_HOURS=24

# Tiempo de vida del Refresh Token expresado en días (ej: 30 = 1 mes)
RT_EXPIRATION_DAYS=30

# Límite de intentos fallidos antes de bloquear IP temporalmente
LOGIN_MAX_ATTEMPTS=5

# Tiempo de penalización (en minutos) cuando se supera el límite de intentos
LOGIN_BLOCK_MINUTES=15

# ==============================================================================
# PERSISTENCIA: CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL)
# ==============================================================================
# Host de conexión (localhost para local, nombre del servicio para Docker)
DB_HOST=192.168.1.27

# Puerto por defecto expuesto de PostgreSQL
DB_PORT=5432

# Nombre de usuario del motor de base de datos
DB_USER=homelab_user

# Contraseña de acceso al motor de base de datos
DB_PASSWORD=P0stgr3s!S3cur3#DB$2026

# Nombre de la base de datos donde se aloja el esquema relacional
DB_DATABASE=homelab_auth

# Nivel de seguridad SSL para la transmisión de datos (disable para Homelab local)
DB_SSLMODE=disable

# Ejecutar migraciones al inicio (true/false)
RUN_MIGRATIONS=true

# ==============================================================================
# CACHÉ: CONFIGURACIÓN DE REDIS
# ==============================================================================
# IP/hostname del servidor Redis en el homelab
REDIS_HOST=192.168.1.28

# Puerto de Redis expuesto en el host
REDIS_PORT=6379

# Contraseña de acceso a Redis (vacío si no tiene auth)
REDIS_PASSWORD=R3d1s!C4ch3#S3cur3$2026

# Base de datos lógica de Redis a usar (0-15)
REDIS_DB=0

# ==============================================================================
# OBSERVABILIDAD / LOGGING
# ==============================================================================
# Nivel mínimo de logs emitidos: debug | info | warn | error
# En desarrollo usar "debug" para ver el flujo interno completo.
# En producción usar "info" para reducir volumen de logs.
LOG_LEVEL=debug

# Entorno de ejecución: development | staging | production
# En "development" los logs incluyen el archivo y línea de código (caller).
ENVIRONMENT=development

