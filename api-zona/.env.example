# ==============================================================================
# AUTH SERVICE — VARIABLES DE ENTORNO (plantilla — copiar a .env y ajustar)
# ==============================================================================

# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR HTTP
# ==============================================================================
# Puerto local donde escuchará la API de Autenticación
PORT=8080

# Tiempos de espera máximos por ruta (en segundos)
TIMEOUT_LOGIN=15
TIMEOUT_REGISTER=30
TIMEOUT_ME=10

# ==============================================================================
# CONFIGURACIÓN DE SEGURIDAD (JWT)
# ==============================================================================
# Firma secreta HMAC-SHA256 — cambiar por un valor aleatorio largo en producción
JWT_SECRET=super-secret-key-change-me-in-production

# Tiempo de vida del Access Token en horas (ej: 1 = 1h, 24 = 1 día)
JWT_EXPIRATION_HOURS=24

# Tiempo de vida del Refresh Token en días (ej: 7 = 1 semana, 30 = 1 mes)
RT_EXPIRATION_DAYS=30

# ==============================================================================
# PERSISTENCIA: CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL)
# ==============================================================================
# Host o IP del servidor PostgreSQL
DB_HOST=localhost

# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432

# Usuario de la base de datos
DB_USER=homelab_user

# Contraseña del usuario de la base de datos
DB_PASSWORD=homelab_password_change_me

# Nombre de la base de datos
DB_DATABASE=homelab_auth

# Modo SSL: disable | require | verify-full
DB_SSLMODE=disable

# Ejecutar migraciones automáticamente al iniciar el servicio (true/false)
RUN_MIGRATIONS=false

# ==============================================================================
# CACHÉ: CONFIGURACIÓN DE REDIS
# ==============================================================================
# IP/hostname del servidor Redis
REDIS_HOST=localhost

# Puerto de Redis (por defecto 6379)
REDIS_PORT=6379

# Contraseña de Redis — dejar vacío si no tiene autenticación configurada
REDIS_PASSWORD=

# Número de base de datos lógica de Redis a usar (0-15)
REDIS_DB=0

# ==============================================================================
# OBSERVABILIDAD / LOGGING
# ==============================================================================
# Nivel mínimo de logs emitidos: debug | info | warn | error
# - debug: muestra el flujo interno completo (solo en desarrollo)
# - info:  eventos de negocio relevantes (recomendado en producción)
# - warn:  situaciones anómalas no críticas
# - error: fallos que requieren atención
LOG_LEVEL=info

# Entorno de ejecución: development | staging | production
# En "development" los logs incluyen el archivo y línea exacta (caller).
ENVIRONMENT=production
