# ==============================================================================
# ARBOL SERVICE — VARIABLES DE ENTORNO (plantilla — copiar a .env y ajustar)
# ==============================================================================

# ==============================================================================
# CONFIGURACIÓN DEL SERVIDOR HTTP
# ==============================================================================
# Puerto local donde escuchará la API de Arboles
PORT=9095

# Tiempos de espera máximos por ruta (en segundos)
TIMEOUT_LOGIN=15
TIMEOUT_REGISTER=30
TIMEOUT_ME=10

# ==============================================================================
# PERSISTENCIA: CONFIGURACIÓN DE BASE DE DATOS (POSTGRESQL)
# ==============================================================================
# Host o IP del servidor PostgreSQL
DB_HOST=192.168.1.27

# Puerto de PostgreSQL (por defecto 5432)
DB_PORT=5432

# Usuario de la base de datos
DB_USER=homelab_user

# Contraseña del usuario de la base de datos
DB_PASSWORD=P0stgr3s!S3cur3#DB$2026

# Nombre de la base de datos
DB_DATABASE=homelab_auth

# Modo SSL: disable | require | verify-full
DB_SSLMODE=disable

# Ejecutar migraciones automáticamente al iniciar el servicio (true/false)
RUN_MIGRATIONS=false

# ==============================================================================
# OBSERVABILIDAD / LOGGING
# ==============================================================================
# Nivel mínimo de logs emitidos: debug | info | warn | error
LOG_LEVEL=info

# Entorno de ejecución: development | staging | production
ENVIRONMENT=production
