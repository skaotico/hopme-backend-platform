{
  "openapi": "3.0.3",
  "info": {
    "title": "Homelab Platform - Parque API",
    "description": "API para la gestión de Ecoparques en el Homelab Platform.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "Servidor Dinámico (Auto-detectar)"
    },
    {
      "url": "http://localhost:9090",
      "description": "Desarrollo Local (localhost)"
    }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Healthcheck del servicio",
        "description": "Verifica el estado del servicio para monitoreo.",
        "responses": {
          "200": {
            "description": "Servicio saludable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "ok" },
                    "version": { "type": "string", "example": "1.0" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/parques": {
      "get": {
        "summary": "Listar Ecoparques",
        "description": "Retorna una lista de todos los Ecoparques.",
        "responses": {
          "200": {
            "description": "Lista de Ecoparques",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Ecoparque"
                  }
                }
              }
            }
          },
          "500": { "description": "Error interno del servidor" }
        }
      },
      "post": {
        "summary": "Crear un nuevo Ecoparque",
        "description": "Crea un nuevo Ecoparque con los datos proporcionados. Requiere token JWT.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEcoparqueRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ecoparque creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ecoparque"
                }
              }
            }
          },
          "400": { "description": "Datos de entrada inválidos" },
          "500": { "description": "Error interno del servidor" }
        }
      }
    },
    "/api/v1/parques/{id}": {
      "get": {
        "summary": "Obtener Ecoparque por ID",
        "description": "Retorna los detalles de un Ecoparque específico.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "ID del Ecoparque"
          }
        ],
        "responses": {
          "200": {
            "description": "Detalles del Ecoparque",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ecoparque"
                }
              }
            }
          },
          "404": { "description": "Ecoparque no encontrado" },
          "500": { "description": "Error interno del servidor" }
        }
      },
      "put": {
        "summary": "Actualizar Ecoparque",
        "description": "Actualiza los datos de un Ecoparque existente. Requiere token JWT.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "ID del Ecoparque"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEcoparqueRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ecoparque actualizado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Ecoparque"
                }
              }
            }
          },
          "400": { "description": "Datos de entrada inválidos" },
          "404": { "description": "Ecoparque no encontrado" },
          "500": { "description": "Error interno del servidor" }
        }
      },
      "delete": {
        "summary": "Eliminar Ecoparque",
        "description": "Elimina un Ecoparque del sistema. Requiere token JWT.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "ID del Ecoparque"
          }
        ],
        "responses": {
          "204": { "description": "Ecoparque eliminado exitosamente" },
          "404": { "description": "Ecoparque no encontrado" },
          "500": { "description": "Error interno del servidor" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Ecoparque": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid", "example": "123e4567-e89b-12d3-a456-426614174000" },
          "nombre": { "type": "string", "example": "Parque Central" },
          "descripcion": { "type": "string", "example": "Un gran parque en el centro de la ciudad" },
          "direccion": { "type": "string", "example": "Av. Principal 123" },
          "fecha_creacion": { "type": "string", "format": "date-time" },
          "fecha_actualizacion": { "type": "string", "format": "date-time" }
        }
      },
      "CreateEcoparqueRequest": {
        "type": "object",
        "required": ["nombre"],
        "properties": {
          "nombre": { "type": "string", "example": "Parque Central" },
          "descripcion": { "type": "string", "example": "Un gran parque en el centro de la ciudad" },
          "direccion": { "type": "string", "example": "Av. Principal 123" }
        }
      },
      "UpdateEcoparqueRequest": {
        "type": "object",
        "properties": {
          "nombre": { "type": "string", "example": "Parque Central Renovado" },
          "descripcion": { "type": "string", "example": "Un gran parque en el centro de la ciudad (Renovado)" },
          "direccion": { "type": "string", "example": "Av. Principal 123, Puerta Norte" }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
